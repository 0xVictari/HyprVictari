# Chicago95: notificaciones como dialogos de Win95, abajo a la derecha
# encima de la taskbar (30 px). Solo overrides de /etc/dunst/dunstrc.
# Probar: killall dunst; notify-send "Titulo" "Cuerpo"

[global]
    origin = bottom-right
    offset = (6, 36)
    width = (200, 360)
    height = (0, 200)
    notification_limit = 5
    gap_size = 4
    padding = 8
    horizontal_padding = 10
    frame_width = 3
    corner_radius = 0
    separator_color = frame
    font = Sans 10
    format = "<b>%s</b>\n%b"
    icon_position = left
    max_icon_size = 32
    icon_theme = Chicago95
    enable_recursive_icon_lookup = true
    progress_bar = true
    progress_bar_corner_radius = 0
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    background = "#c0c0c0"
    foreground = "#404040"
    frame_color = "#808080"
    highlight = "#000080"
    timeout = 4

[urgency_normal]
    background = "#c0c0c0"
    foreground = "#000000"
    frame_color = "#000080"
    highlight = "#000080"
    timeout = 6

[urgency_critical]
    background = "#c0c0c0"
    foreground = "#000000"
    frame_color = "#aa0000"
    highlight = "#000080"
    timeout = 0
