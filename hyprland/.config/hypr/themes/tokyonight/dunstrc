# Notificaciones (desktop, Hyprland). Lo que no esta aca usa el default de
# /etc/dunst/dunstrc. Colores: paleta de Waybar + borde activo de Hyprland.
# Probar: killall dunst; notify-send "Titulo" "Cuerpo"  (D-Bus lo relanza solo)

[global]
    origin = top-right
    # debajo de Waybar (34 px de alto)
    offset = (12, 46)
    width = (200, 380)
    height = (0, 200)
    notification_limit = 5
    gap_size = 6
    padding = 10
    horizontal_padding = 12
    frame_width = 2
    corner_radius = 10
    separator_color = frame
    font = JetBrainsMono Nerd Font 11
    format = "<b>%s</b>\n%b"
    icon_position = left
    max_icon_size = 48
    progress_bar = true
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    background = "#1e1e2e"
    foreground = "#a6adc8"
    frame_color = "#414868"
    timeout = 4

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#7aa2f7"
    timeout = 6

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#f38ba8"
    timeout = 0
