#!/usr/bin/env python3
"""Vuelve a publicar el CLIPBOARD con xclip cuando el dueño solo ofrece UTF-8 (caso Zed).

Zed (X11) anuncia solo UTF8_STRING y text/plain;charset=utf-8; el cliente de Citrix
pide STRING/TEXT/COMPOUND_TEXT y no pega nada. xclip sí responde a esos formatos.
Escucha eventos XFixes (sin polling). Efecto extra: el texto sobrevive al cerrar Zed.
"""
import ctypes
import ctypes.util
import subprocess
import time

ZED_SIGNATURE = "text/plain;charset=utf-8"

x11 = ctypes.cdll.LoadLibrary(ctypes.util.find_library("X11"))
xfixes = ctypes.cdll.LoadLibrary(ctypes.util.find_library("Xfixes"))
x11.XOpenDisplay.restype = ctypes.c_void_p
x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
x11.XDefaultRootWindow.restype = ctypes.c_ulong
x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
x11.XInternAtom.restype = ctypes.c_ulong
x11.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
x11.XNextEvent.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
xfixes.XFixesQueryExtension.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int)]
xfixes.XFixesSelectSelectionInput.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_ulong]

XFixesSetSelectionOwnerNotifyMask = 1


def xclip_out(target: str) -> bytes | None:
    try:
        r = subprocess.run(
            ["xclip", "-selection", "clipboard", "-t", target, "-o"],
            capture_output=True, timeout=2,
        )
    except subprocess.TimeoutExpired:
        return None
    return r.stdout if r.returncode == 0 else None


def normalize() -> None:
    targets = (xclip_out("TARGETS") or b"").decode(errors="replace").split()
    if ZED_SIGNATURE not in targets or "STRING" in targets:
        return
    text = xclip_out("UTF8_STRING") or xclip_out(ZED_SIGNATURE)
    if not text:
        return
    subprocess.run(
        ["xclip", "-selection", "clipboard", "-i"],
        input=text, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


def main() -> None:
    dpy = x11.XOpenDisplay(None)
    if not dpy:
        raise SystemExit("no se pudo abrir el display (¿DISPLAY?)")
    event_base, error_base = ctypes.c_int(), ctypes.c_int()
    if not xfixes.XFixesQueryExtension(dpy, ctypes.byref(event_base), ctypes.byref(error_base)):
        raise SystemExit("XFixes no disponible")
    clipboard = x11.XInternAtom(dpy, b"CLIPBOARD", 0)
    xfixes.XFixesSelectSelectionInput(
        dpy, x11.XDefaultRootWindow(dpy), clipboard, XFixesSetSelectionOwnerNotifyMask
    )
    event = ctypes.create_string_buffer(192)  # sizeof(XEvent)
    while True:
        x11.XNextEvent(dpy, event)
        if ctypes.c_int.from_buffer(event).value == event_base.value:
            time.sleep(0.05)  # dejar que el nuevo dueño termine de publicar
            normalize()


if __name__ == "__main__":
    main()
