# Main modifier key

# Terminal (replace with your preferred terminal command)
super + q
    kitty

# File Manager (replace with your file manager command)
super + e
    nemo

# Restart rofi or equivalent
super + r
    pkill rofi || rofi -show drun -show-icons

# Lock session (replace with appropriate lock screen command)
control + alt + l
    cinnamon-screensaver-command -l

# Screenshot Area to Clipboard
super + shift + s
    flameshot gui

# Kill Brave Browser
super + shift + b
    killall brave

# Kill Citrix Workspace
super + shift + x
    killall wfica

# Toggle monitor layout (single/dual HDMI)
super + shift + m
    ~/.dwm/monitor-setup.sh
