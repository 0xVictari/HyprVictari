# Terminal de la sesión Cinnamon (en Hyprland es kitty). Mismo look que kitty:
# GoMono Nerd Font 10, padding 25, opacidad 0.85 y Tokyo Night Storm con los
# mismos ajustes que themes/tokyonight/kitty.conf (selección #3d59a1).

### General ###

mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

cursor-style = block
cursor-style-blink = true

clipboard-read = allow
clipboard-write = allow

window-inherit-working-directory = true
# Cinnamon es flotante: barra de título del sistema
window-decoration = auto
window-padding-x = 25
window-padding-y = 25

confirm-close-surface = false

### Fonts ###

font-family = "GoMono Nerd Font"
font-size = 10

### Colores (Tokyo Night Storm, igual que kitty) ###

background = #24283b
foreground = #a9b1d6
cursor-color = #c0caf5
cursor-text = #1a1b26
selection-background = #3d59a1
selection-foreground = #c0caf5

palette = 0=#414868
palette = 1=#f7768e
palette = 2=#73daca
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#c0caf5
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#73daca
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5

### Background ###

background-opacity = 0.85

### Turn off Ligatures ###

font-feature = -dlig
font-feature = -liga
font-feature = -calt

### Keybinds ####

keybind = control+shift+r=reload_config

keybind = control+shift+-=new_split:down
keybind = control+shift+'=new_split:right
keybind = control+shift+z=toggle_split_zoom

keybind = control+shift+h=goto_split:left
keybind = control+shift+j=goto_split:bottom
keybind = control+shift+k=goto_split:top
keybind = control+shift+l=goto_split:right
keybind = control+shift+p=goto_split:previous
keybind = control+shift+n=goto_split:next

keybind = control+up=adjust_selection:up
keybind = control+down=adjust_selection:down
keybind = control+left=adjust_selection:left
keybind = control+right=adjust_selection:right

keybind = control+shift+equal=equalize_splits
keybind = control+shift+up=resize_split:up,10
keybind = control+shift+down=resize_split:down,10
keybind = control+shift+left=resize_split:left,10
keybind = control+shift+right=resize_split:right,10

keybind = control+shift+enter=new_tab
keybind = control+comma=previous_tab
keybind = control+.=next_tab
keybind = control+shift+,=move_tab:-1
keybind = control+shift+.=move_tab:+1
keybind = control+shift+º=toggle_tab_overview
